{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BioMikaDexieSchema",
  "databaseName": "BioMikaDB",
  "version": 1,
  "tables": {
    "profile": "id, dob, height, gender",
    "entries": "++id, date, weight, energyLevel, sleepQuality"
  },
  "entities": {
    "UserProfile": {
      "type": "object",
      "required": [
        "id",
        "dob",
        "height",
        "gender"
      ],
      "properties": {
        "id": {
          "type": "string",
          "default": "main_user"
        },
        "dob": {
          "type": "string",
          "format": "date"
        },
        "height": {
          "type": "number",
          "minimum": 50,
          "maximum": 250
        },
        "gender": {
          "type": "string",
          "enum": [
            "male",
            "female"
          ]
        }
      }
    },
    "Entry": {
      "type": "object",
      "required": [
        "date",
        "weight"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "autoIncrement": true
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "weight": {
          "type": "number"
        },
        "back": {
          "type": [
            "number",
            "null"
          ]
        },
        "waist": {
          "type": [
            "number",
            "null"
          ]
        },
        "glutes": {
          "type": [
            "number",
            "null"
          ]
        },
        "leg": {
          "type": [
            "number",
            "null"
          ]
        },
        "arm": {
          "type": [
            "number",
            "null"
          ]
        },
        "neck": {
          "type": [
            "number",
            "null"
          ]
        },
        "fatMass": {
          "type": [
            "number",
            "null"
          ]
        },
        "skeletalMuscleMass": {
          "type": [
            "number",
            "null"
          ]
        },
        "energyLevel": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "sleepQuality": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}